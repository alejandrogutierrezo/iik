# Ejemplo de secretos para iik. NO suba a GitHub un archivo con claves reales.
#
# * En Streamlit Community Cloud: copie lo que necesite en  App → Settings → Secrets.
# * En su computadora: copie este archivo como .streamlit/secrets.toml (ya está en .gitignore).
#
# Los valores de primer nivel también se exponen como variables de entorno. Todos son opcionales.

# --- ERA5 directo de Copernicus CDS -------------------------------------------------------------
# Con esto la opción «ERA5 Copernicus CDS» funciona sin que cada alumno escriba su clave.
# Ojo: todas las descargas usarán su cuenta y su cola en el CDS.
# CDSAPI_URL = "https://cds.climate.copernicus.eu/api"
# CDSAPI_KEY = "su-clave-personal-del-cds"

# --- Servidor compartido ------------------------------------------------------------------------
# Se activa solo en Streamlit Community Cloud. Fíjelo en "1" en otro servidor con varios usuarios.
# IIK_SERVIDOR_COMPARTIDO = "1"
# Cálculos pesados (terreno, AEP) a la vez; los demás esperan su turno. 0 = sin límite.
# IIK_TAREAS_SIMULTANEAS = "2"
# Celdas máximas de la malla de terreno (400 × 400 = 20 km por lado a 50 m). 0 = sin límite.
# IIK_MAX_CELDAS = "160000"
# Estilo para todos en el servidor compartido: "nothing-oscuro", "nothing-claro" o "clasica".
# VIENTOMX_ESTILO = "nothing-oscuro"

# --- Avanzado -----------------------------------------------------------------------------------
# Servidor Overpass propio para buscar turbinas de OpenStreetMap (se prueba antes que los públicos).
# VIENTOMX_OVERPASS_URL = "https://overpass-api.de/api/interpreter"
